# Local configuration only. Copy placeholders into .env and supply your own values.
PTV_DEV_ID=your_ptv_developer_id
PTV_API_KEY=your_ptv_api_key
PTV_BASE_URL=https://timetableapi.ptv.vic.gov.au

OPENAI_API_KEY=your_openai_api_key
# Use a model available to your API project that supports Responses function calling.
OPENAI_MODEL=your_responses_capable_model
