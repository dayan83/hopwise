{
  "schema_version": 1,
  "dataset_version": "0.1.0",
  "suite_id": "basic_conversation",
  "description": "Five synthetic multi-turn scenarios. Golden state, calls and source facts are independent of scripted LLM outputs.",
  "notes": [
    "This suite is separate from the frozen single-turn dataset v0.3.0 and does not change its scoring semantics.",
    "Each turn gets a new FixtureTransport and fixed reference time; only ConversationState is retained within a scenario.",
    "No-call turns reuse dormant search/departure definitions solely for safe transport injection and clock scoping. All match counts must remain zero.",
    "Exact clarification expectations are narrow contracts for the application's deterministic clarification messages, not general semantic quality scores.",
    "Departure run references in the changed Richmond snapshot are intentionally different so stale board reuse fails source-fact checks."
  ],
  "scenarios": [
    {
      "scenario_id": "retain_station_context",
      "reviewer_notes": [
        "Confirm that the response answers the follow-up for Richmond and keeps each current departure's details together."
      ],
      "turns": [
        {
          "turn_id": "1",
          "question": "What are the next trains from Richmond?",
          "fixture": "fixtures/richmond_departures.json",
          "as_of_utc": "2026-11-17T22:55:00Z",
          "reset_before": false,
          "expected_state_before_reset": {
            "station_name": null,
            "departure_limit": null
          },
          "expected_state_before": {
            "station_name": null,
            "departure_limit": null
          },
          "expected_state_after": {
            "station_name": "Richmond",
            "departure_limit": 5
          },
          "expected_calls": [
            {
              "name": "search_stations",
              "arguments": {
                "query": "Richmond"
              }
            },
            {
              "name": "get_departures_with_disruptions",
              "arguments": {
                "stop_id": 1101,
                "limit": 5
              }
            }
          ],
          "expected_facts": {
            "station_match_count": 1,
            "selected_stop_id": 1101,
            "departure_count": 3,
            "departures": [
              {
                "run_ref": "310001",
                "stop_id": 1101,
                "route_id": 2101,
                "destination_name": "Glen Waverley",
                "platform_number": "9",
                "scheduled_departure_utc": "2026-11-17T22:58:00Z",
                "estimated_departure_utc": "2026-11-17T22:58:00Z",
                "delay_seconds": 0,
                "delay_status": "matches_schedule"
              },
              {
                "run_ref": "310002",
                "stop_id": 1101,
                "route_id": 2102,
                "destination_name": "Belgrave",
                "platform_number": "10",
                "scheduled_departure_utc": "2026-11-17T23:02:00Z",
                "estimated_departure_utc": "2026-11-17T23:02:00Z",
                "delay_seconds": 0,
                "delay_status": "matches_schedule"
              },
              {
                "run_ref": "310003",
                "stop_id": 1101,
                "route_id": 2103,
                "destination_name": "Lilydale",
                "platform_number": "10",
                "scheduled_departure_utc": "2026-11-17T23:06:00Z",
                "estimated_departure_utc": "2026-11-17T23:06:00Z",
                "delay_seconds": 0,
                "delay_status": "matches_schedule"
              }
            ]
          },
          "expected_http_counts": [
            1,
            1
          ],
          "required_response_notes": [
            "Report only the freshly returned Richmond services, with scheduled and estimated times distinguished."
          ],
          "prohibited_claims": [
            "More services were returned than the three supplied by this fixture."
          ]
        },
        {
          "turn_id": "2",
          "question": "What about the next two?",
          "fixture": "multiturn_fixtures/richmond_followup_two.json",
          "as_of_utc": "2026-11-17T22:56:00Z",
          "reset_before": false,
          "expected_state_before_reset": {
            "station_name": "Richmond",
            "departure_limit": 5
          },
          "expected_state_before": {
            "station_name": "Richmond",
            "departure_limit": 5
          },
          "expected_state_after": {
            "station_name": "Richmond",
            "departure_limit": 2
          },
          "expected_calls": [
            {
              "name": "search_stations",
              "arguments": {
                "query": "Richmond"
              }
            },
            {
              "name": "get_departures_with_disruptions",
              "arguments": {
                "stop_id": 1101,
                "limit": 2
              }
            }
          ],
          "expected_facts": {
            "station_match_count": 1,
            "selected_stop_id": 1101,
            "departure_count": 2,
            "departures": [
              {
                "run_ref": "310101",
                "stop_id": 1101,
                "route_id": 2101,
                "destination_name": "Glen Waverley",
                "platform_number": "8",
                "scheduled_departure_utc": "2026-11-17T22:59:00Z",
                "estimated_departure_utc": "2026-11-17T23:00:00Z",
                "delay_seconds": 60,
                "delay_status": "late"
              },
              {
                "run_ref": "310102",
                "stop_id": 1101,
                "route_id": 2102,
                "destination_name": "Belgrave",
                "platform_number": "10",
                "scheduled_departure_utc": "2026-11-17T23:03:00Z",
                "estimated_departure_utc": "2026-11-17T23:03:00Z",
                "delay_seconds": 0,
                "delay_status": "matches_schedule"
              }
            ]
          },
          "expected_http_counts": [
            1,
            1
          ],
          "required_response_notes": [
            "Retain Richmond and report no more than two services from this turn's new lookup.",
            "Use the changed platform, times and run records; do not replay the previous board."
          ],
          "prohibited_claims": [
            "Runs 310001, 310002 or 310003 are the newly returned departures for this turn."
          ]
        }
      ]
    },
